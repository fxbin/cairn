# Project planning, discussions, and delivery-process artifacts stay local.
/docs/
/.vidt/

# Benchmark task definitions, verifiers, configuration, evaluator output, and
# disposable repositories are local-only research material. Do not commit any
# content under this directory.
/benchmarks/

# Workspace-local runtime configuration may reference machine-local credential
# environment variables; it is per-machine state and must never be committed.
/.agent/

# macOS and Go build/test outputs.
.DS_Store
**/.DS_Store
/bin/
/dist/
/cairn
*.test
*.out
coverage.out

# Local editor and temporary files.
.idea/
.vscode/
.zcode/
*.swp
*.tmp
